# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Access Control / Authentication (Dashboard & API Protection)
# Set unique non-empty values in deployment. Do not use example credentials.
AUTH_USER=admin
AUTH_PASSWORD=
# Set PROTECT_ALL_ROUTES=true to password-protect the entire web dashboard, or false to only protect /api/shoonya-* endpoints
PROTECT_ALL_ROUTES=false
SCREENER_PASSWORDS=
SCREENER_SECRET_SALT=

# Shoonya option premium chart (current OAuth access token; keep private)
SHOONYA_UID=
SHOONYA_ACCESS_TOKEN=
SHOONYA_CLIENT_ID=
SHOONYA_SECRET_CODE=

