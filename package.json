{
  "name": "upstocks-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "stockAnalysis": "node scripts/analyze.mjs",
    "updateInstruments": "node -e \"import('./src/lib/server/instruments.js').then(m => m.getUnifiedInstruments({ forceRefresh: true }))\"",
    "analyze": "node scripts/analyze.mjs",
    "backtest": "node scripts/backtest.mjs",
    "paperTrade": "node scripts/paperTrade.mjs",
    "scan": "node scripts/scan.mjs",
    "signal": "node scripts/generateSignal.mjs",
    "fetchData": "node scripts/fetchData.mjs",
    "lint": "eslint src/",
    "test": "node --test test/engine/*.test.js",
    "test:engine": "node --test test/engine/*.test.js",
    "test:gemini": "node --env-file=.env scripts/testGemini.mjs",
    "briefing": "node --env-file=.env scripts/marketBriefing.mjs",
    "signal:315": "node --env-file-if-exists=.env scripts/run315OptionSignal.mjs",
    "backtest:options": "node scripts/backtestOptionSignal.mjs",
    "schedule:315": "node --env-file-if-exists=.env scripts/schedule315Signal.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@riyazpanarwala/react-financial-charts": "^3.0.0",
    "@vercel/analytics": "^2.0.1",
    "@zero65tech/indian-stock-market": "^4.5.3",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "d3-format": "^3.1.2",
    "d3-time-format": "^4.1.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^13.4.6",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-full-screen": "^1.1.1",
    "react-icons": "^5.7.0",
    "react-papaparse": "^4.4.0",
    "react-select": "^5.10.2",
    "react-window": "^1.8.11",
    "recharts": "^3.10.1",
    "sass": "^1.105.1",
    "stock-nse-india": "^1.4.0",
    "technicalindicators": "^3.1.0",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7"
  },
  "engines": {
    "node": "24.11.1",
    "npm": "11.6.2"
  }
}
